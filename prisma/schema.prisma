generator client {
  provider = "prisma-client"
  output   = "../infrastructure/db/generated"
}

datasource db {
  provider = "postgresql"
}

enum QuoteStatus {
  draft
  sent
  accepted
  rejected
  expired
}

enum FiscalRegime {
  vat
  occasional
}

enum CatalogTier {
  web_assets
  enterprise
}

enum PricingKind {
  fixed
  range
  on_request
}

enum BillingKind {
  one_time
  recurring
  on_demand
}

enum BillingInterval {
  monthly
  yearly
}

/// Service Catalog bounded context. Reference data composed into quotes.
/// Pricing/billing discriminated unions are modelled relationally: the *Kind
/// enum is the discriminant and the variant-specific columns are nullable,
/// guarded by CHECK constraints in the migration (see catalog_items SQL).
model CatalogItem {
  id              String           @id
  tier            CatalogTier
  title           String
  description     String
  pricingKind     PricingKind
  currency        String           @default("EUR")
  priceCents      Int? // pricingKind = fixed
  fromCents       Int? // pricingKind = range
  toCents         Int? // pricingKind = range
  billingKind     BillingKind
  billingInterval BillingInterval? // billingKind = recurring
  defaultOptional Boolean          @default(true)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([tier])
  @@map("catalog_items")
}

model Quote {
  id           String       @id @db.Uuid
  number       String       @unique
  status       QuoteStatus  @default(draft)
  client       Json
  project      String
  intro        String
  issuedAt     DateTime
  validUntil   DateTime
  // Default `vat` keeps existing rows (created under VAT assumptions) correct on
  // backfill; the composer always sends the regime explicitly (default occasional).
  fiscalRegime FiscalRegime @default(vat)
  vatRate      Float
  lineItems    Json
  metadata     Json
  acceptance   Json?
  // Set when the quote is archived (hidden from the default admin list).
  // Orthogonal to `status`; null means active.
  archivedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("quotes")
}

enum LeadSource {
  google_maps
  outscraper
  serpapi
}

enum LeadStatus {
  new
  analyzed
  qualified
  discarded
}

enum LeadGenerationJobStatus {
  pending
  running
  completed
  failed
}

model Lead {
  id          String     @id
  companyName String
  category    String?
  website     String?
  phone       String?
  email       String?
  address     String?
  city        String?
  source      LeadSource
  status      LeadStatus
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  analyses LeadAnalysis[]

  @@map("leads")
}

model LeadAnalysis {
  id               String   @id
  leadId           String
  strategy         String
  performanceScore Float?
  lcp              Float?
  fcp              Float?
  cls              Float?
  tbt              Float?
  analyzedAt       DateTime

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_analyses")
}

model LeadGenerationJob {
  id          String                  @id
  query       String
  location    String
  status      LeadGenerationJobStatus
  totalFound  Int                     @default(0)
  analyzed    Int                     @default(0)
  qualified   Int                     @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  error       String?
  createdAt   DateTime                @default(now())

  @@map("lead_generation_jobs")
}
