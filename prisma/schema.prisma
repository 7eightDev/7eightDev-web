generator client {
  provider = "prisma-client"
  output   = "../infrastructure/db/generated"
}

datasource db {
  provider = "postgresql"
}

enum QuoteStatus {
  draft
  sent
  accepted
  rejected
  expired
}

enum FiscalRegime {
  vat
  occasional
}

enum CatalogTier {
  web_assets
  enterprise
}

enum PricingKind {
  fixed
  range
  on_request
}

enum BillingKind {
  one_time
  recurring
  on_demand
}

enum BillingInterval {
  monthly
  yearly
}

/// Service Catalog bounded context. Reference data composed into quotes.
/// Pricing/billing discriminated unions are modelled relationally: the *Kind
/// enum is the discriminant and the variant-specific columns are nullable,
/// guarded by CHECK constraints in the migration (see catalog_items SQL).
model CatalogItem {
  id              String           @id
  tier            CatalogTier
  title           String
  description     String
  pricingKind     PricingKind
  currency        String           @default("EUR")
  priceCents      Int? // pricingKind = fixed
  fromCents       Int? // pricingKind = range
  toCents         Int? // pricingKind = range
  billingKind     BillingKind
  billingInterval BillingInterval? // billingKind = recurring
  defaultOptional Boolean          @default(true)
  sortOrder       Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([tier])
  @@map("catalog_items")
}

model Quote {
  id           String       @id @db.Uuid
  number       String       @unique
  status       QuoteStatus  @default(draft)
  client       Json
  project      String
  intro        String
  issuedAt     DateTime
  validUntil   DateTime
  // Default `vat` keeps existing rows (created under VAT assumptions) correct on
  // backfill; the composer always sends the regime explicitly (default occasional).
  fiscalRegime FiscalRegime @default(vat)
  vatRate      Float
  lineItems    Json
  metadata     Json
  acceptance   Json?
  // Set when the quote is archived (hidden from the default admin list).
  // Orthogonal to `status`; null means active.
  archivedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("quotes")
}

enum LeadSource {
  google_maps
  outscraper
  serpapi
}

enum LeadStatus {
  new
  analyzed
  qualified
  discarded
}

enum OutreachStatus {
  not_contacted
  audit_sent
  in_talks
  closed_won
  rejected
}

enum LeadGenerationJobStatus {
  pending
  running
  completed
  failed
}

model Lead {
  id          String     @id
  jobId       String?
  companyName String
  category    String?
  website     String?
  websiteKey  String?
  phone       String?
  email       String?
  address     String?
  city        String?
  source      LeadSource
  status      LeadStatus
  outreachStatus   OutreachStatus @default(not_contacted)
  lastContactedAt  DateTime?
  outreachNotes    String?
  // Pinned by the user via the star in the leads list: marks the leads they
  // intend to contact next. Optional so the pipeline creates leads without it.
  favorite         Boolean        @default(false)
  // Set when the PageSpeed analysis failed: keeps the reason the lead was
  // marked `discarded` visible in the admin detail view (null = ok/not tried).
  analysisError String?
  // Technologies detected on the lead's website (e.g. WordPress, Wix, jQuery),
  // surfaced in the admin data table. Archived from the pipeline as a bonus
  // signal of how hard the site is to outrank.
  techStack   String[]   @default([])
  // Footer copyright line detected on the lead's website (e.g. "© 2019"), a
  // signal of when the site was built/resold and thus how stale it is.
  copyright   String?
  // True when the lead's website was detected running paid-advertising
  // trackers (Google Ads, Meta Pixel, Google Tag Manager).
  hasAds      Boolean    @default(false)
  // Detected ad-tracking platforms, e.g. ['Google Ads', 'Meta Pixel', 'GTM'].
  // Surfaces per-platform detail in the admin UI and mirrors the techStack
  // array pattern.
  adsTrackers String[]   @default([])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  analyses LeadAnalysis[]
  job      LeadGenerationJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@unique([websiteKey])
  @@index([jobId])
  @@map("leads")
}

model LeadAnalysis {
  id               String   @id
  leadId           String
  strategy         String
  performanceScore Float?
  lcp              Float?
  fcp              Float?
  cls              Float?
  tbt              Float?
  analyzedAt       DateTime

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_analyses")
}

model LeadGenerationJob {
  id          String                  @id
  query       String
  location    String
  // How many leads were requested for this search (nil = adapter default).
  // Persisted so a job can be re-run with the same options.
  quantity    Int?
  // Optional search criteria narrowing the results: a tech/stack term the site
  // must match and a free-text copyright line the footer should contain.
  // Persisted so a re-run repeats the same constraints.
  techStack   String?
  copyright   String?
  status      LeadGenerationJobStatus
  totalFound  Int                     @default(0)
  analyzed    Int                     @default(0)
  qualified   Int                     @default(0)
  // Pinned to the top of the "recent searches" sidebar via the star toggle.
  favorite    Boolean                 @default(false)
  startedAt   DateTime?
  completedAt DateTime?
  error       String?
  createdAt   DateTime                @default(now())

  leads Lead[]

  @@map("lead_generation_jobs")
}
